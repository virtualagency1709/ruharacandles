# =============================================================================
# RUHARA CANDLES - ENVIRONMENT CONFIGURATION
# =============================================================================

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="Ruhara Candles"
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210" # Indian 10-digit mobile number with country code

# Database Connection (Neon, Supabase, or any PostgreSQL instance)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ruhara_candles?schema=public"

# NextAuth (Authentication)
NEXTAUTH_SECRET="ruhara-super-secret-key-32-chars-long-minimum-jwt"
NEXTAUTH_URL="http://localhost:3000"

# Admin Initial Seed Credentials
ADMIN_NAME="Ruhara Admin"
ADMIN_EMAIL="admin@ruharacandles.com"
ADMIN_PASSWORD="AdminRuhara@2026!"

# Razorpay Payment Gateway (Test or Live mode)
RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKeyHere"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# Shiprocket Courier API Integration
SHIPROCKET_EMAIL="your-shiprocket-email@domain.com"
SHIPROCKET_PASSWORD="your-shiprocket-password"
SHIPROCKET_PICKUP_LOCATION="Primary" # Set in your Shiprocket pickup locations

# Cloudinary (Media storage & CDN for product images)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email Notifications (Resend or SMTP)
RESEND_API_KEY="re_YourResendApiKey"
EMAIL_FROM="orders@ruharacandles.com"

# Shipping & Store Rules
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD="999" # In INR (₹)
NEXT_PUBLIC_FLAT_SHIPPING_FEE="79"        # In INR (₹)
NEXT_PUBLIC_COD_FEE="49"                  # In INR (₹)
NEXT_PUBLIC_GST_PERCENT="18"              # GST included in price
